{
  "name": "ai-file-organizer",
  "version": "1.0.0",
  "description": "AI驱动的Mac文件整理助手",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:vite": "vite",
    "dev:electron": "NODE_ENV=development electron .",
    "build": "vite build",
    "build:main": "mkdir -p dist/main && cp src/main/*.cjs dist/main/",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && npm run build:main && electron-builder",
    "dist": "npm run build && npm run build:main && electron-builder",
    "dist:mac": "npm run build && npm run build:main && electron-builder --mac",
    "electron": "electron ."
  },
  "keywords": [
    "ai",
    "file-organizer",
    "mac",
    "desktop"
  ],
  "author": "AI Assistant",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "build": {
    "appId": "com.aiassistant.fileorganizer",
    "productName": "AI文件整理助手",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/main",
        "to": "dist/main"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns"
    },
    "dmg": {
      "title": "AI文件整理助手安装",
      "backgroundColor": "#ffffff",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    }
  }
}
